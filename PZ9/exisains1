def progression_sum(a1, d, n):
    if n == 1:
        return a1
    return (a1 + (n - 1) * d) + progression_sum(a1, d, n - 1)

print("Сумма:", progression_sum(2, 3, 5))


def reverse_string(s):
    # Базовый случай: если строка пустая, возвращаем её
    if not s:
        return s
    
    # Рекурсивный случай: переворачиваем строку без первого символа 
    # и добавляем первый символ в конец
    return reverse_string(s[1:]) + s[0]

# Пример использования:
text = "abc"
print(f"Исходная строка: {text}")
print(f"Перевернутая строка: {reverse_string(text)}")




